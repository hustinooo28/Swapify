{
  "expo": {
    "name": "Swapify",
    "slug": "swapify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D6AE5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swapify.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Swapify uses Face ID to securely verify your identity and log you in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D6AE5"
      },
      "package": "com.swapify.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Swapify needs access to your photos to upload item images."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Swapify uses Face ID to securely verify your identity."
        }
      ]
    ],
    "scheme": "swapify"
  }
}